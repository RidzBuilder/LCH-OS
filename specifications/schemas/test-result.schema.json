{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lch-os.dev/schemas/test-result.schema.json",
  "title": "LCH-OS Conformance Test Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_id",
    "run_id",
    "test_id",
    "test_version",
    "baseline_id",
    "status",
    "started_at",
    "completed_at",
    "evidence_refs",
    "limitations",
    "decision_rationale"
  ],
  "properties": {
    "result_id": {
      "type": "string",
      "pattern": "^RES-ACL-[A-Z0-9-]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "test_id": {
      "type": "string",
      "minLength": 1
    },
    "test_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "baseline_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_TESTED",
        "NOT_APPLICABLE",
        "INCONCLUSIVE"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "requirement_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "invariant_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_rationale": {
      "type": "string",
      "minLength": 1
    },
    "failure_class": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "FC-01",
        "FC-02",
        "FC-03",
        "FC-04",
        "FC-05",
        "FC-06",
        "FC-07",
        "FC-08",
        "FC-09",
        "FC-10",
        null
      ]
    },
    "remediation_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "not_applicable_basis": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
