{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lch-os.dev/schemas/baseline-manifest.schema.json",
  "title": "LCH-OS Conformance Baseline Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "baseline_id",
    "baseline_version",
    "track",
    "scope",
    "schema_dialect",
    "artifacts",
    "status"
  ],
  "properties": {
    "baseline_id": {
      "type": "string",
      "pattern": "^BL-ACL-[A-Z0-9-]+$"
    },
    "baseline_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "track": {
      "const": "A"
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "schema_dialect": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "validator": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "version",
          "path",
          "digest"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "algorithm",
              "value"
            ],
            "properties": {
              "algorithm": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "change_record_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "approval_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "DRAFT",
        "UNDER_REVIEW",
        "APPROVED",
        "SUPERSEDED",
        "REVOKED"
      ]
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
