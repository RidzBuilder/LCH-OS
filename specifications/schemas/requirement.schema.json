{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lch-os.dev/schemas/requirement.schema.json",
  "title": "LCH-OS Canonical Requirement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requirement_id",
    "title",
    "normative_statement",
    "source_artifact",
    "requirement_version",
    "applicability",
    "preconditions",
    "acceptance_criteria",
    "linked_invariants",
    "linked_tests",
    "criticality",
    "status"
  ],
  "properties": {
    "requirement_id": {
      "type": "string",
      "pattern": "^REQ-ACL-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "normative_statement": {
      "type": "string",
      "minLength": 1
    },
    "source_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "version"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      }
    },
    "requirement_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "applicability": {
      "type": "object",
      "required": [
        "statement"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "predicate_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "linked_invariants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "linked_tests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "criticality": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "status": {
      "enum": [
        "DRAFT",
        "APPROVED",
        "IMPLEMENTED",
        "VERIFIED",
        "SUPERSEDED",
        "RETIRED"
      ]
    }
  }
}
